<%-- diet 화면 공통 스타일 (각 JSP 의 <head> 안에서 include) --%>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<style>
	:root {
		--green: #2f9e6b; --green-dark: #237a52; --green-soft: #e8f5ee;
		--ink: #1f2a24; --muted: #6b7a72; --bg: #f5f7f4; --line: #e3e8e4;
		--carb: #f2b33d; --prot: #2f9e6b; --fat: #e8684a;
	}
	body { font-family: Pretendard, -apple-system, "Malgun Gothic", sans-serif; background: var(--bg); color: var(--ink); }
	a { color: inherit; text-decoration: none; }

	/* 상단바 */
	.topbar { background: #fff; border-bottom: 1px solid var(--line); }
	.topbar .inner { max-width: 960px; margin: 0 auto; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; }
	.brand { font-weight: 800; font-size: 1.25rem; color: var(--green); letter-spacing: -0.02em; }
	.nav-link-soft { color: var(--muted); font-weight: 600; margin-left: 20px; }
	.nav-link-soft:hover, .nav-link-soft.active { color: var(--green); }

	/* 레이아웃 */
	.page { max-width: 960px; margin: 0 auto; padding: 32px 16px 80px; }
	.page-title { font-weight: 800; font-size: 1.6rem; letter-spacing: -0.03em; margin: 0; }
	.page-sub { color: var(--muted); margin-top: 4px; }
	.box { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
	.box-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 16px; }
	.box-title .step { display: inline-flex; width: 24px; height: 24px; border-radius: 50%; background: var(--green); color: #fff;
		font-size: .8rem; align-items: center; justify-content: center; margin-right: 8px; }

	/* 버튼 */
	.btn-green { background: var(--green); color: #fff; border: 0; border-radius: 10px; font-weight: 600; padding: 10px 18px; }
	.btn-green:hover { background: var(--green-dark); color: #fff; }
	.btn-line { background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 10px; font-weight: 600; padding: 10px 18px; }
	.btn-line:hover { border-color: var(--green); color: var(--green); }
	.btn-danger-line { background: #fff; color: var(--fat); border: 1px solid #f3c9bf; border-radius: 10px; font-weight: 600; padding: 10px 18px; }
	.btn-danger-line:hover { background: #fdf0ec; }

	/* 식사 유형 배지 */
	.meal { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: .8rem; font-weight: 700; }
	.meal-am { background: #fff4d6; color: #a06d00; }
	.meal-lunch { background: var(--green-soft); color: var(--green-dark); }
	.meal-dinner { background: #e9ecfb; color: #4553a8; }
	.meal-snack { background: #fde9ef; color: #b23c63; }

	/* 음식 칩 */
	.chip { display: inline-block; padding: 4px 10px; margin: 0 4px 6px 0; border-radius: 999px; background: #f1f4f2; color: var(--ink); font-size: .85rem; }

	/* 목록 카드 */
	.diet-card { display: block; height: 100%; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 20px; transition: .15s; }
	.diet-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(31, 42, 36, .08); border-color: #cfe3d7; }
	.diet-card .date { font-weight: 700; font-size: 1.05rem; }
	.diet-card .kcal { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); color: var(--muted); font-size: .9rem; }
	.diet-card .kcal b { color: var(--ink); font-size: 1.15rem; }
	.empty { text-align: center; padding: 64px 16px; }
	.empty .icon { font-size: 3rem; }

	/* 분석 */
	.score-ring { width: 150px; height: 150px; border-radius: 50%; margin: 0 auto;
		background: conic-gradient(var(--green) calc(var(--score) * 1%), var(--line) 0); display: grid; place-items: center; }
	.score-ring .inner { width: 118px; height: 118px; border-radius: 50%; background: #fff; display: grid; place-items: center; text-align: center; }
	.score-ring .num { font-size: 2.4rem; font-weight: 800; line-height: 1; color: var(--green); }
	.score-ring .unit { font-size: .8rem; color: var(--muted); }
	.stat { border-radius: 12px; background: #f7f9f8; padding: 14px; text-align: center; height: 100%; }
	.stat .label { font-size: .8rem; color: var(--muted); }
	.stat .value { font-size: 1.3rem; font-weight: 800; }
	.stat .pct { font-size: .8rem; font-weight: 700; }
	.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; }
	.macro-bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: var(--line); }
	.macro-bar div { height: 100%; }
	.food-table th { color: var(--muted); font-weight: 600; font-size: .85rem; border-bottom-color: var(--line); }
	.food-table td { vertical-align: middle; border-bottom-color: var(--line); }
	.food-table tfoot td { font-weight: 800; border-bottom: 0; }
	.food-table .text-end { white-space: nowrap; }

	/* 작성 폼: 식사 유형 / 음식 선택 (체크박스·라디오를 카드처럼) */
	.pick input { display: none; }
	.pick label { display: block; cursor: pointer; border: 1.5px solid var(--line); border-radius: 12px; padding: 10px 14px; background: #fff; transition: .12s; }
	.pick label:hover { border-color: #b9d9c6; }
	.pick input:checked + label { border-color: var(--green); background: var(--green-soft); }
	.pick.type label { text-align: center; font-weight: 700; }
	.pick .name { font-weight: 700; }
	.pick .meta { font-size: .8rem; color: var(--muted); }
	.pick .check { float: right; color: var(--green); font-weight: 800; visibility: hidden; }
	.pick input:checked + label .check { visibility: visible; }
	.form-control { border-radius: 10px; border-color: var(--line); padding: 10px 14px; }
	.form-control:focus { border-color: var(--green); box-shadow: 0 0 0 .2rem rgba(47, 158, 107, .15); }
	.alert-soft { background: #fdf0ec; color: #b2452c; border: 1px solid #f3c9bf; border-radius: 12px; padding: 12px 16px; }
	.action-bar { position: sticky; bottom: 0; background: rgba(245, 247, 244, .92); backdrop-filter: blur(6px);
		padding: 16px 0; margin-top: 24px; border-top: 1px solid var(--line); }
</style>